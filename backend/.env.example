# Copy this file to .env and fill in your own values. Never commit .env.
# Get a free Gemini API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here
# Comma-separated values form an ordered fallback chain (each retry tries the next model)
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash,gemini-flash-lite-latest
ALLOWED_ORIGINS=http://localhost:3000
MAX_FILE_MB=5
MIN_JD_CHARS=100
MAX_JD_CHARS=15000
